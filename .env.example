# ========================================
# IDX AI Stock Assistant - Configuration
# ========================================

# --- Application ---
APP_NAME=IDX AI Stock Assistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=idx_ai
POSTGRES_USER=idx_ai_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=
TELEGRAM_USE_WEBHOOK=false
# Admin telegram user id (notification recipient)
TELEGRAM_ADMIN_ID=
# Chat/group where automated crypto alerts are delivered (defaults to TELEGRAM_ADMIN_ID)
TELEGRAM_CHAT_ID=

# --- AI / LLM ---
# Primary: Qwen (OpenAI-compatible). API key "qwen" = local/opencode.
LLM_PROVIDER=qwen
QWEN_API_KEY=qwen
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=qwen3.5-397b

# Secondary: Groq (fast, free fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Tertiary: Gemini (backup)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Stock Data ---
STOCK_CACHE_TTL=300
STOCK_DATA_DAYS=90

# --- Rate Limiting ---
RATE_LIMIT_PER_USER=30
RATE_LIMIT_WINDOW=60

# --- Crypto Scanner (Tokocrypto) ---
# No API key/secret needed: only public market-data endpoints are used.
CRYPTO_SCANNER_ENABLED=true
CRYPTO_SCAN_INTERVAL_MINUTES=5
# true = simulate alerts (log only, no Telegram send, no AI)
CRYPTO_SCANNER_DRY_RUN=false
# false = matikan notifikasi Telegram untuk momentum alert crypto
# (scan tetap jalan untuk paper trading; hanya report Telegram yang off)
CRYPTO_ALERT_TELEGRAM_ENABLED=true

# Quote assets to scan, comma separated
CRYPTO_QUOTE_ASSETS=USDT,IDR
# Minimum 24h quote volume in quote currency (empty = sensible default ~1M)
CRYPTO_MIN_QUOTE_VOLUME=

# Scoring / alert thresholds
CRYPTO_MIN_SCORE_ALERT=75
CRYPTO_MAX_CANDIDATES_AI=10
CRYPTO_MAX_ALERTS_PER_SCAN=3
CRYPTO_ALERT_COOLDOWN_MINUTES=60

# Pair filtering
CRYPTO_STABLECOIN_QUOTES=USDT,USDC,BUSD,DAI,TUSD,FRAX,PAX,FDUSD
CRYPTO_MIN_VOLUME_PAIRS=200
CRYPTO_MAX_CANDLES=300

# HTTP / network
CRYPTO_API_TIMEOUT=30
CRYPTO_MAX_CONCURRENCY=5
CRYPTO_MAX_RETRIES=3

# Scoring weights (positive factors; sum ~1.0)
CRYPTO_WEIGHT_TREND=0.25
CRYPTO_WEIGHT_MOMENTUM=0.25
CRYPTO_WEIGHT_VOLUME=0.25
CRYPTO_WEIGHT_BREAKOUT=0.25

# --- Crypto Paper Trading (SIMULASI, bukan transaksi sungguhan) ---
CRYPTO_PAPER_TRADING_ENABLED=true
CRYPTO_PAPER_INITIAL_BALANCE=1000000
CRYPTO_PAPER_QUOTE_ASSET=USDT
CRYPTO_PAPER_ALLOCATION_PERCENT=10
CRYPTO_PAPER_MAX_POSITIONS=5
# Skor minimal untuk buka posisi (backtest: 75 lebih baik dari 80 —
# menangkap 2x lebih banyak setup dengan win rate tetap ~88%)
CRYPTO_PAPER_ENTRY_SCORE=75
# false = jangan beli di puncak breakout (buy the top). Gunakan strategi
# pullback-in-uptrend di bawah.
CRYPTO_PAPER_ENTRY_REQUIRE_BREAKOUT=false
# true = wajib tren 1h bullish (EMA9>EMA20>EMA50 + MACD bullish)
CRYPTO_PAPER_ENTRY_REQUIRE_UPTREND=true
# Maks jarak harga di atas EMA20 untuk dianggap "pullback sehat" (persen).
# Backtest: 5% menangkap 2x lebih banyak setup daripada 3%.
CRYPTO_PAPER_ENTRY_PULLBACK_MAX_PCT=5.0
# true = kirim notifikasi Telegram saat open/close posisi
CRYPTO_PAPER_NOTIFY=true
# Menit tunggu sebelum boleh beli ulang symbol yang baru kena SL
CRYPTO_PAPER_SL_COOLDOWN_MINUTES=120
# true = hanya buka posisi yang verdict AI-nya STRONG_WATCH/WATCH.
# Kandidat yang AI-nya bilang NEUTRAL/AVOID dilewati. Jika AI mati / verdict
# tidak ada, kandidat tetap diproses (AI bukan titik kegagalan tunggal).
CRYPTO_PAPER_AI_FILTER_ENABLED=true

# --- Crypto Real Trading (UANG SUNGGUHAN — sangat hati-hati) ---
# !!! PENTING !!!
# Buat API Key di Tokocrypto dengan izin TRADE ONLY (matikan izin Withdraw!).
# JANGAN pernah beri izin withdraw ke key ini.
# Default OFF — bot tidak akan pernah eksekusi order real kecuali di-ON kan.
CRYPTO_REAL_TRADING_ENABLED=false
CRYPTO_REAL_API_KEY=your_trade_only_api_key_here
CRYPTO_REAL_API_SECRET=your_trade_only_api_secret_here
# Quote asset yang diperdagangkan (harus ada saldonya).
CRYPTO_REAL_QUOTE_ASSET=USDT
# % saldo yang dialokasikan per posisi — KECIL! (default 2%)
CRYPTO_REAL_ALLOCATION_PERCENT=2.0
# Minimal nilai order (quote). Order di bawah ini DITOLAK exchange (NOTIONAL).
CRYPTO_REAL_MIN_ORDER_QUOTE=5.0
# Maks posisi real yang terbuka bersamaan.
CRYPTO_REAL_MAX_POSITIONS=3
# Stop buka posisi baru jika PnL real sudah turun melebihi nilai ini (USDT).
# 0 = nonaktifkan (TIDAK disarankan).
CRYPTO_REAL_MAX_DRAWDOWN=50.0
# true = notifikasi Telegram untuk setiap eksekusi order real
CRYPTO_REAL_NOTIFY=true

# --- MQTT (ESP32 sound/display alerts) ---
# true = publish event paper trading ke broker MQTT (Mosquitto di VPS).
# Topic yang dipakai: <MQTT_TOPIC_PREFIX>/buy | /profit | /loss | /heartbeat
MQTT_ENABLED=true
# Dari dalam container docker, host VPS = host.docker.internal
# (di host langsung pakai 127.0.0.1 / localhost)
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=idxbot
MQTT_PASSWORD=your_mqtt_password_here
MQTT_TOPIC_PREFIX=crypto/trade
MQTT_HEARTBEAT_SECONDS=60
MQTT_TIMEOUT=5
